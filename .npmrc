# Supply-chain hardening (2026-07-22 security review).
#
# Mirrors Headquarters/app/.npmrc — see that file for the full rationale.
# Short version: install scripts are how npm supply-chain attacks execute, and
# disabling them costs nothing here because only esbuild declares one.
#
# NOTE: this project is mirrored 1-to-1 into the Centurion app under
# app/src/pages/brokerage-continuum/. Any dependency change made here must be
# mirrored there.
ignore-scripts=true
audit=true
